{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:txt": "node --test dev/textDatabase.test.ts",
    "test:members": "node --test dev/memberOrder.test.ts",
    "test:roles": "node --test dev/roomRoles.test.ts",
    "test:ui-state": "node --test dev/roomUiState.test.ts",
    "test:i18n": "node --test dev/i18n.test.mjs",
    "test": "node --test dev/*.test.ts dev/i18n.test.mjs src/lib/fileTransfer.test.mjs",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io-client": "^4.8.3",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
