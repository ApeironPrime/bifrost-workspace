generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  MEMBER
}

enum RoomAccessRole {
  HOST
  MODERATOR
  MEMBER
  VIEWER
}

model User {
  id                   String              @id @default(uuid()) @db.Uuid
  name                 String              @db.VarChar(100)
  email                String              @unique @db.VarChar(254)
  passwordHash         String              @map("password_hash")
  emailVerifiedAt      DateTime?           @map("email_verified_at")
  totpSecret           String?             @map("totp_secret") @db.VarChar(128)
  totpEnabledAt        DateTime?           @map("totp_enabled_at")
  totpRecoveryHashes   String[]            @default([]) @map("totp_recovery_hashes")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  profile              UserProfile?
  ownedWorkspaces      Workspace[]         @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
  hostedRooms          Room[]              @relation("HostedRooms")
  createdRooms         Room[]              @relation("CreatedRooms")
  roomMemberships      RoomMember[]
  roomNotes            UserRoomNote[]
  refreshTokens        RefreshToken[]
  verificationTokens   VerificationToken[]
  oauthAccounts        OAuthAccount[]
  createdInvites       WorkspaceInvite[]   @relation("InviteCreator")

  @@map("users")
}

enum VerificationPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model VerificationToken {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  purpose   VerificationPurpose
  tokenHash String              @unique @map("token_hash") @db.VarChar(128)
  codeHash  String              @map("code_hash") @db.VarChar(128)
  expiresAt DateTime            @map("expires_at")
  usedAt    DateTime?           @map("used_at")
  createdAt DateTime            @default(now()) @map("created_at")
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_tokens")
}

model OAuthAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String   @db.VarChar(32)
  providerAccountId String   @map("provider_account_id") @db.VarChar(191)
  email             String?  @db.VarChar(254)
  createdAt         DateTime @default(now()) @map("created_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model UserProfile {
  userId        String   @id @map("user_id") @db.Uuid
  avatarDataUrl String?  @map("avatar_data_url") @db.Text
  completedAt   DateTime @default(now()) @map("completed_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Workspace {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @db.VarChar(120)
  slug        String            @unique @db.VarChar(140)
  ownerId     String            @map("owner_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]
  rooms       Room[]
  roomMembers RoomMember[]
  roomRoles   RoomLabel[]
  invites     WorkspaceInvite[]

  @@map("workspaces")
}

model WorkspaceInvite {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  createdById  String    @map("created_by_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(128)
  invitedEmail String?   @map("invited_email") @db.VarChar(254)
  maxUses      Int?      @map("max_uses")
  useCount     Int       @default(0) @map("use_count")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User      @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([invitedEmail])
  @@map("workspace_invites")
}

model WorkspaceMember {
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now()) @map("joined_at")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Room {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(120)
  description String?      @db.VarChar(255)
  workspaceId String       @map("workspace_id") @db.Uuid
  hostId      String?      @map("host_id") @db.Uuid
  createdById String?      @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  host        User?        @relation("HostedRooms", fields: [hostId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation("CreatedRooms", fields: [createdById], references: [id], onDelete: SetNull)
  members     RoomMember[]
  roles       RoomLabel[]
  collabState RoomCollabState?
  userNotes   UserRoomNote[]

  @@index([workspaceId])
  @@index([hostId])
  @@map("rooms")
}

model RoomMember {
  workspaceId String         @map("workspace_id") @db.Uuid
  roomId      String         @map("room_id") @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  role        RoomAccessRole @default(MEMBER)
  labelIds    String[]       @default([]) @map("label_ids")
  assignedAt  DateTime       @default(now()) @map("assigned_at")
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  room        Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, roomId, userId])
  @@index([roomId])
  @@index([userId])
  @@map("room_members")
}

model RoomLabel {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  roomId      String    @map("room_id") @db.Uuid
  name        String    @db.VarChar(32)
  color       String    @db.VarChar(16)
  priority    Int       @default(100)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([workspaceId, roomId])
  @@map("room_roles")
}

model RoomCollabState {
  roomId          String   @id @map("room_id") @db.Uuid
  messagesJson    Json     @default("[]") @map("messages_json")
  boardJson       Json     @default("{\"items\":[],\"tombstones\":{}}") @map("board_json")
  sharedNotesJson Json     @default("{}") @map("shared_notes_json")
  hlc             String?  @db.VarChar(160)
  updatedAt       DateTime @updatedAt @map("updated_at")
  room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("room_collab_states")
}

model UserRoomNote {
  roomId      String   @map("room_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  body        String   @default("") @db.Text
  isShared    Boolean  @default(false) @map("is_shared")
  updatedAtMs Float?   @map("updated_at_ms") @db.DoublePrecision
  hlc         String?  @db.VarChar(160)
  updatedAt   DateTime @updatedAt @map("updated_at")
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId])
  @@map("user_room_notes")
}
