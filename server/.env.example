PORT=3000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_with_a_long_random_secret
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/bifrost_db?schema=public"

# Trust boundary for X-Forwarded-For: keep false when exposed directly; when behind a
# reverse proxy, set an explicit comma-separated proxy IP/CIDR allowlist (never "true").
TRUST_PROXY=false

# AUD-08a Auth Rate Limiting defaults (single-process in-memory stores)
AUTH_LOGIN_IP_EMAIL_MAX=10
AUTH_LOGIN_IP_EMAIL_WINDOW_MS=900000
AUTH_LOGIN_IP_MAX=30
AUTH_LOGIN_IP_WINDOW_MS=900000
AUTH_REGISTER_IP_MAX=10
AUTH_REGISTER_IP_WINDOW_MS=3600000

# AUD-01 TURN REST Credentials (keep TURN_URLS empty for STUN-only mode; never expose secret to client)
STUN_URLS=stun:stun.l.google.com:19302
# Example when coturn is running locally:
# TURN_URLS=turn:127.0.0.1:3478?transport=udp,turn:127.0.0.1:3478?transport=tcp
TURN_URLS=
# Absolute or server-relative path to 64-hex-char shared secret file (required when TURN_URLS is set)
TURN_SHARED_SECRET_FILE=../secrets/turn_shared_secret
TURN_TTL_SECONDS=900
TURN_RATE_LIMIT_MAX=30
TURN_RATE_LIMIT_WINDOW_MS=900000
# Optional public/mapped IP pair passed to coturn when behind NAT (never guess in code)
# TURN_EXTERNAL_IP=203.0.113.10/172.18.0.5
